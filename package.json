{
  "name": "arklean",
  "version": "0.1.1",
  "private": true,
  "description": "Safe and explainable GHCR retention policies",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-dist.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check src tests scripts",
    "format": "biome check --write src tests scripts",
    "test": "node --test tests/*.test.js",
    "coverage": "node --test --experimental-test-coverage tests/*.test.js",
    "check": "pnpm lint && pnpm typecheck && pnpm build && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "24.1.0",
    "typescript": "5.8.3"
  },
  "license": "Apache-2.0"
}
